.DS_Store
recv.txt
api_key.sec
test-credentials.local
__pycache__/

# Audio test files (raw / preview / lossy formats — FLAC is the committed
# canonical format; everything else is local-only intermediate or preview).
*.wav
*.webm
*.ogg
*.m4a
*.pcm

# Editor configs
.cursor/
.vscode/

# Test data exports
teamData.*.json
test_team.json

# Server data files (created by tests and local dev server)
data/players/
data/teams/
data/games/
data/memberships/
data/shares/
data/invites/
data/users/
data/index.json

# Feature worktrees (parallel Claude Code sessions)
.worktrees/

# Playwright test infrastructure
tests/node_modules
tests/test-results/
tests/playwright-report/
# Theme-sweep output: ~100 screenshots + contrast JSON per run. They are a
# working artifact to eyeball and diff locally, not something to version —
# committing them put 25 MB of PNGs in the history once already.
tests/sweep/shots/
tests/sweep/test-results/
tests/test-data-dir/

# Demo-video recording artifacts (playwright.demo.config.ts). The finished mp4s
# are committed under docs/clips/; the raw webm takes and the throwaway backend
# data the demo specs create are not.
tests/demo-results/
tests/demo-data-dir/
# The recorder's own transcript — the cutter reads it, nobody else needs it.
tests/.demo-record*.log

# Per-session local backend data copies (scripts/dev-backend.sh)
.dev-data/

# Claude Code per-session state (agent worktrees, session memory/transcripts)
.claude/worktrees/
.claude/projects/

# Per-session dev-server launch configs. Every session that runs the in-IDE
# preview writes a config here, and tracking it turned routine preview setup
# into a stream of one-line diffs on main. If a launch config is ever worth
# sharing across all sessions, add it back deliberately with
# `git add -f .claude/launch.json`.
.claude/launch.json

# Session scratch (scout screenshots, working files). Never shipped — note
# that deploy-excludes.txt does not cover it, so a tracked scratchpad/ would
# sync straight to the S3 bucket.
scratchpad/

# Local Python venvs (e.g. the 3.12 venv used to validate requirements.lock)
.venv*/
